# ==============================================================================
# Suricata Local Rules - Analytical-Intelligence
# ==============================================================================
# Custom rules for organization-specific detections
# SIDs must be >= 1000000 to avoid conflicts with ET rules
# ==============================================================================

# Example: Detect internal port scanning attempts
# alert tcp $HOME_NET any -> $HOME_NET any (msg:"AI LOCAL - Internal Port Scan Detected"; flags:S; threshold:type both,track by_src,count 20,seconds 10; sid:1000001; rev:1; classtype:attempted-recon;)

# Example: Detect SSH brute force (complements auth collector)
# alert tcp any any -> $HOME_NET 22 (msg:"AI LOCAL - SSH Brute Force Attempt"; flow:to_server; threshold:type both,track by_src,count 5,seconds 60; sid:1000002; rev:1; classtype:attempted-admin;)

# Example: Detect potential C2 beaconing (regular intervals)
# alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"AI LOCAL - Possible C2 Beaconing"; flow:established,to_server; dsize:<100; threshold:type both,track by_src,count 10,seconds 300; sid:1000003; rev:1; classtype:trojan-activity;)

