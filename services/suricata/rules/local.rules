# ==========================================
# Analytical-Intelligence — LOCAL IDS Rules
# ==========================================
# Ruleset focused on fast detections for:
# DDoS, DoS, PortScan, Recon, BruteForce, Botnet, WebAttack, RCE, Malware
#
# Notes:
# - SIDs start at 1000001 and increment sequentially.
# - All rules use rev:1.
# - PCRE characters like ';' are escaped as \;.
# ==========================================

# ------------------------------------------
# 1. DDoS (Distributed Denial of Service)
# Priority: 1 (Critical)
# ------------------------------------------
alert tcp any any -> any any (msg:"AI DDoS: TCP SYN flood (aggregate to destination)"; flags:S,12; detection_filter:track by_dst, count 10000, seconds 10; classtype:attempted-dos; priority:1; sid:1000001; rev:1;)
alert udp any any -> any any (msg:"AI DDoS: UDP flood (aggregate to destination)"; detection_filter:track by_dst, count 10000, seconds 10; classtype:attempted-dos; priority:1; sid:1000002; rev:1;)
alert icmp any any -> any any (msg:"AI DDoS: ICMP flood (aggregate to destination)"; itype:8; detection_filter:track by_dst, count 10000, seconds 10; classtype:attempted-dos; priority:1; sid:1000003; rev:1;)
# ------------------------------------------
# 2. DoS (Denial of Service)
# Priority: 2 (High)
# ------------------------------------------
alert tcp any any -> any any (msg:"AI DoS: TCP SYN flood (single source)"; flags:S,12; detection_filter:track by_src, count 1000, seconds 3; classtype:attempted-dos; priority:2; sid:1000011; rev:1;)
alert udp any any -> any any (msg:"AI DoS: UDP flood (single source)"; detection_filter:track by_src, count 1000, seconds 3; classtype:attempted-dos; priority:2; sid:1000012; rev:1;)
alert icmp any any -> any any (msg:"AI DoS: ICMP ping flood (single source)"; itype:8; detection_filter:track by_src, count 1000, seconds 3; classtype:attempted-dos; priority:2; sid:1000013; rev:1;)

# ------------------------------------------
# 3. PortScan (Port Scanning)
# Priority: 3 (Medium)
# ------------------------------------------
alert tcp any any -> any any (msg:"AI PortScan: TCP SYN scan (rapid probes)"; flags:S,12; detection_filter:track by_src, count 15, seconds 5; classtype:attempted-recon; priority:3; sid:1000021; rev:1;)
alert tcp any any -> any any (msg:"AI PortScan: TCP connect scan (bursty attempts)"; flags:S,12; detection_filter:track by_src, count 50, seconds 10; classtype:attempted-recon; priority:3; sid:1000022; rev:1;)
alert udp any any -> any any (msg:"AI PortScan: UDP scan behavior"; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; priority:3; sid:1000023; rev:1;)
alert tcp any any -> any any (msg:"AI PortScan: Xmas scan packet"; flags:FPU; classtype:attempted-recon; priority:3; sid:1000024; rev:1;)
alert tcp any any -> any any (msg:"AI PortScan: Null scan packet"; flags:0; classtype:attempted-recon; priority:3; sid:1000025; rev:1;)
alert tcp any any -> any any (msg:"AI PortScan: FIN scan packet"; flags:F; classtype:attempted-recon; priority:3; sid:1000026; rev:1;)
alert udp any any -> any any (msg:"AI PortScan: Aggressive UDP scan (high-rate probes)"; detection_filter:track by_src, count 60, seconds 10; classtype:attempted-recon; priority:3; sid:1000035; rev:1;)

# ------------------------------------------
# 4. Recon (Reconnaissance / Scanners)
# Priority: 3 (Medium)
# ------------------------------------------
alert icmp any any -> any any (msg:"AI Recon: ICMP ping sweep (echo request burst)"; itype:8; detection_filter:track by_src, count 15, seconds 5; classtype:attempted-recon; priority:3; sid:1000046; rev:1;)
alert icmp any any -> any any (msg:"AI Recon: ICMP timestamp request"; itype:13; classtype:attempted-recon; priority:3; sid:1000047; rev:1;)
alert icmp any any -> any any (msg:"AI Recon: ICMP address mask request"; itype:17; classtype:attempted-recon; priority:3; sid:1000048; rev:1;)
alert arp any any -> any any (msg:"AI Recon: ARP scan (who-has burst)"; arp.opcode:1; detection_filter:track by_src, count 25, seconds 10; classtype:attempted-recon; priority:3; sid:1000049; rev:1;)
alert dns any any -> any 53 (msg:"AI Recon: DNS CHAOS version.bind TXT query"; dns.query; content:"version.bind"; nocase; dns.rrtype:TXT; classtype:attempted-recon; priority:3; sid:1000050; rev:1;)
alert dns any any -> any 53 (msg:"AI Recon: DNS CHAOS hostname.bind TXT query"; dns.query; content:"hostname.bind"; nocase; dns.rrtype:TXT; classtype:attempted-recon; priority:3; sid:1000051; rev:1;)

# User-Agent Scanners
alert http any any -> any any (msg:"AI Recon: Nmap user-agent"; flow:to_server,established; http.user_agent; content:"Nmap"; nocase; classtype:attempted-recon; priority:3; sid:1000052; rev:1;)
alert http any any -> any any (msg:"AI Recon: Nikto user-agent"; flow:to_server,established; http.user_agent; content:"Nikto"; nocase; classtype:attempted-recon; priority:3; sid:1000053; rev:1;)
alert http any any -> any any (msg:"AI Recon: Nessus user-agent"; flow:to_server,established; http.user_agent; content:"Nessus"; nocase; classtype:attempted-recon; priority:3; sid:1000055; rev:1;)
alert http any any -> any any (msg:"AI Recon: OpenVAS user-agent"; flow:to_server,established; http.user_agent; content:"OpenVAS"; nocase; classtype:attempted-recon; priority:3; sid:1000056; rev:1;)
alert http any any -> any any (msg:"AI Recon: Acunetix user-agent"; flow:to_server,established; http.user_agent; content:"Acunetix"; nocase; classtype:attempted-recon; priority:3; sid:1000057; rev:1;)
alert http any any -> any any (msg:"AI Recon: w3af user-agent"; flow:to_server,established; http.user_agent; content:"w3af"; nocase; classtype:attempted-recon; priority:3; sid:1000058; rev:1;)
alert http any any -> any any (msg:"AI Recon: Arachni user-agent"; flow:to_server,established; http.user_agent; content:"Arachni"; nocase; classtype:attempted-recon; priority:3; sid:1000059; rev:1;)
alert http any any -> any any (msg:"AI Recon: Gobuster user-agent"; flow:to_server,established; http.user_agent; content:"gobuster"; nocase; classtype:attempted-recon; priority:3; sid:1000060; rev:1;)
alert http any any -> any any (msg:"AI Recon: WPScan user-agent"; flow:to_server,established; http.user_agent; content:"wpscan"; nocase; classtype:attempted-recon; priority:3; sid:1000061; rev:1;)
alert http any any -> any any (msg:"AI Recon: DirBuster user-agent"; flow:to_server,established; http.user_agent; content:"DirBuster"; nocase; classtype:attempted-recon; priority:3; sid:1000062; rev:1;)
alert http any any -> any any (msg:"AI Recon: WhatWeb user-agent"; flow:to_server,established; http.user_agent; content:"WhatWeb"; nocase; classtype:attempted-recon; priority:3; sid:1000063; rev:1;)
alert http any any -> any any (msg:"AI Recon: zgrab user-agent"; flow:to_server,established; http.user_agent; content:"zgrab"; nocase; classtype:attempted-recon; priority:3; sid:1000064; rev:1;)
alert http any any -> any any (msg:"AI Recon: nuclei user-agent"; flow:to_server,established; http.user_agent; content:"nuclei"; nocase; classtype:attempted-recon; priority:3; sid:1000065; rev:1;)

# ------------------------------------------
# 5. Botnet (C2 / Beaconing)
# Priority: 1 (Critical)
# ------------------------------------------
alert dns any any -> any 53 (msg:"AI Botnet: High-rate DNS queries (beaconing)"; dns.query; content:"."; detection_filter:track by_src, count 20, seconds 60; classtype:trojan-activity; priority:1; sid:1000072; rev:1;)
alert dns any any -> any 53 (msg:"AI Botnet: Suspicious DNS TXT query"; dns.rrtype:TXT; classtype:trojan-activity; priority:1; sid:1000073; rev:1;)

# ------------------------------------------
# 6. WebAttack (Web Attacks)
# Priority: 2 (High)
# ------------------------------------------
alert http any any -> any any (msg:"AI WebAttack: XSS (script tag)"; flow:to_server,established; http.uri; content:"<script"; nocase; classtype:web-application-attack; priority:2; sid:1000076; rev:1;)
alert http any any -> any any (msg:"AI WebAttack: XSS (javascript protocol)"; flow:to_server,established; http.uri; content:"javascript:"; nocase; classtype:web-application-attack; priority:2; sid:1000078; rev:1;)
alert http any any -> any any (msg:"AI WebAttack: Suspicious cmd parameter"; flow:to_server,established; http.uri; content:"cmd="; nocase; classtype:web-application-attack; priority:2; sid:1000079; rev:1;)
alert http any any -> any any (msg:"AI RCE: /bin/sh attempt"; flow:to_server,established; http.uri; content:"/bin/sh"; nocase; classtype:web-application-attack; priority:1; sid:1000082; rev:1;)
alert http any any -> any any (msg:"AI RCE: /bin/bash attempt"; flow:to_server,established; http.uri; content:"/bin/bash"; nocase; classtype:web-application-attack; priority:1; sid:1000083; rev:1;)